# @trigger — la fonction ET le CREATE TRIGGER, en une seule forme.
#
#   @trigger touch_updated_at before update on users for each row {
#       NEW.updated_at = now();
#       RETURN NEW;
#   }
#
# `RETURN` reste explicite : un AFTER ou un FOR EACH STATEMENT n'a pas les
# mêmes conventions qu'un BEFORE ... FOR EACH ROW, et une règle implicite
# différente selon le timing serait un piège.
#
# Sur plusieurs tables — `on (a, b, c)` — l'expanseur génère une fonction par
# table, chacune liée à une table connue. NEW et OLD deviennent donc résolubles,
# là où une fonction partagée produit un `trigger-ambiguous-table`.

macro trigger
header {name:ident} {timing:word} {events:words} on {tables:list} for each {each:word}[ when ({when:parens})]

template
CREATE OR REPLACE FUNCTION {name}_fn()
RETURNS TRIGGER
LANGUAGE plpgsql
AS $pgweave_macro$
{declares}BEGIN
{body}
END;
$pgweave_macro$;

CREATE TRIGGER {name}
{timing} {events} ON {tables}
FOR EACH {each}
EXECUTE FUNCTION {name}_fn();
end
