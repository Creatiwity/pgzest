# @procedure — comme @function, mais sans valeur de retour.
#
#   @procedure archive_org(target UUID) {
#       UPDATE organizations SET archived = true WHERE id = target;
#   }

macro procedure
header {name:ident}({params:parens})[ {attrs:keywords}]

option language = plpgsql -> LANGUAGE {}
flag security_definer -> SECURITY DEFINER

template
CREATE OR REPLACE PROCEDURE {name}({params})
{options}
AS $pgweave_macro$
{declares}BEGIN
{body}
END;
$pgweave_macro$;
end
