# Example of a custom macro. The format is the same as the bundled macros —
# see `pgzest macros --verbose`.
#
# @audited adds the audit columns repeated on every table:
#
#   @audited users {
#       id    UUID PRIMARY KEY,
#       email TEXT NOT NULL
#   }

macro audited
header {name:ident}

template
CREATE TABLE {name} (
{body},
    created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT now()
);
end
