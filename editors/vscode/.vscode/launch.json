{
  "version": "0.2.0",
  "configurations": [
    {
      // F5: builds the extension, opens a development VS Code window and
      // loads examples/playground/ in it directly — a real project with
      // schema/, migrations/ and pgzest.toml, so you do not have to look
      // for a folder by hand.
      "name": "Run Extension (playground)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/../../examples/playground"
      ],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "npm: compile"
    },
    {
      // Variant: empty window, open the folder you want to test yourself.
      "name": "Run Extension (empty window)",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "npm: compile"
    }
  ]
}
