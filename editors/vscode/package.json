{
  "name": "pgzest",
  "displayName": "pgzest",
  "description": "Raw PostgreSQL, with zest: checked the way PostgreSQL would, without a database — diagnostics, hover, completion and macro expansion for SQL, PL/pgSQL and SQL in Rust strings.",
  "version": "0.1.0",
  "publisher": "Creatiwity",
  "author": {
    "name": "Creatiwity",
    "url": "https://creatiwity.net"
  },
  "license": "(MIT OR Apache-2.0)",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#17140F",
    "theme": "dark"
  },
  "homepage": "https://pgzest.creatiwity.net",
  "repository": {
    "type": "git",
    "url": "https://github.com/Creatiwity/pgzest.git",
    "directory": "editors/vscode"
  },
  "bugs": {
    "url": "https://github.com/Creatiwity/pgzest/issues"
  },
  "keywords": [
    "postgresql",
    "postgres",
    "sql",
    "plpgsql",
    "type checking",
    "language server",
    "rust"
  ],
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:pgsql",
    "onLanguage:sql",
    "onLanguage:rust"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "pgsql",
        "aliases": [
          "PostgreSQL",
          "PL/pgSQL",
          "pgsql"
        ],
        "extensions": [
          ".pgsql"
        ],
        "filenames": [],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "pgmacro",
        "aliases": [
          "pgzest macro"
        ],
        "extensions": [
          ".pgmacro"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pgsql",
        "scopeName": "source.pgsql",
        "path": "./syntaxes/pgsql.tmLanguage.json"
      },
      {
        "scopeName": "source.plpgsql",
        "path": "./syntaxes/plpgsql.tmLanguage.json"
      },
      {
        "scopeName": "pgzest.injection.rust-sql",
        "path": "./syntaxes/rust-sql.injection.tmLanguage.json",
        "injectTo": [
          "source.rust"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.sql": "pgsql"
        }
      }
    ],
    "semanticTokenScopes": [
      {
        "scopes": {
          "type": [
            "entity.name.type.sql"
          ],
          "function": [
            "entity.name.function.sql"
          ],
          "class": [
            "entity.name.class.sql"
          ],
          "enumMember": [
            "variable.other.enummember.sql"
          ],
          "interface": [
            "entity.name.type.interface.sql"
          ],
          "namespace": [
            "entity.name.namespace.sql"
          ]
        }
      }
    ],
    "configuration": {
      "title": "pgzest",
      "properties": {
        "pgzest.server.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `pgzest` binary that runs the language server (`pgzest lsp`). Empty: the binary shipped with the extension, otherwise `pgzest` on the `PATH`."
        },
        "pgzest.schemaFile": {
          "type": "string",
          "default": "",
          "description": "Path to a schema.sql file for type-checking"
        }
      }
    },
    "configurationDefaults": {
      "[pgsql]": {
        "editor.semanticHighlighting.enabled": true
      },
      "[sql]": {
        "editor.semanticHighlighting.enabled": true
      },
      "rust-analyzer.semanticHighlighting.strings.enable": false
    },
    "commands": [
      {
        "command": "pgzest.expandMacro",
        "title": "Show Macro Expansion",
        "category": "pgzest"
      }
    ],
    "keybindings": [
      {
        "command": "pgzest.expandMacro",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e",
        "when": "editorTextFocus && (editorLangId == pgsql || editorLangId == sql)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "pgzest.expandMacro",
          "when": "editorLangId == pgsql || editorLangId == sql",
          "group": "pgzest"
        }
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc -p ./ --noEmit",
    "esbuild": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --target=node22",
    "bundle": "npm run esbuild -- --sourcemap",
    "compile": "npm run typecheck && npm run bundle",
    "watch": "npm run esbuild -- --sourcemap --watch",
    "vscode:prepublish": "npm run typecheck && npm run esbuild -- --minify",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/vscode": "^1.120.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "ovsx": "^1.3.0",
    "typescript": "^7.0.2"
  }
}
