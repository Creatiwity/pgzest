{
  "name": "pgsql-tools",
  "displayName": "pgsql-tools",
  "description": "PostgreSQL SQL + PL/pgSQL language support (type-checking, completion, hover)",
  "version": "0.1.0",
  "publisher": "pgsql-tools",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:pgsql",
    "onLanguage:sql"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "pgsql",
        "aliases": [
          "PostgreSQL",
          "PL/pgSQL",
          "pgsql"
        ],
        "extensions": [
          ".pgsql"
        ],
        "filenames": [],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "pgmacro",
        "aliases": [
          "pgsql-tools macro"
        ],
        "extensions": [
          ".pgmacro"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pgsql",
        "scopeName": "source.pgsql",
        "path": "./syntaxes/pgsql.tmLanguage.json"
      },
      {
        "scopeName": "source.plpgsql",
        "path": "./syntaxes/plpgsql.tmLanguage.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "scopes": {
          "type": [
            "entity.name.type.sql"
          ],
          "function": [
            "entity.name.function.sql"
          ],
          "class": [
            "entity.name.class.sql"
          ],
          "enumMember": [
            "variable.other.enummember.sql"
          ],
          "interface": [
            "entity.name.type.interface.sql"
          ],
          "namespace": [
            "entity.name.namespace.sql"
          ]
        }
      }
    ],
    "configuration": {
      "title": "pgsql-tools",
      "properties": {
        "pgsql-tools.lspPath": {
          "type": "string",
          "default": "pgsql-lsp",
          "description": "Path to the pgsql-lsp binary"
        },
        "pgsql-tools.schemaFile": {
          "type": "string",
          "default": "",
          "description": "Path to a schema.sql file for type-checking"
        }
      }
    },
    "configurationDefaults": {
      "[pgsql]": {
        "editor.semanticHighlighting.enabled": true
      },
      "[sql]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
    "commands": [
      {
        "command": "pgsql-tools.expandMacro",
        "title": "Voir l'expansion de la macro",
        "category": "pgsql-tools"
      }
    ],
    "keybindings": [
      {
        "command": "pgsql-tools.expandMacro",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e",
        "when": "editorTextFocus && (editorLangId == pgsql || editorLangId == sql)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "pgsql-tools.expandMacro",
          "when": "editorLangId == pgsql || editorLangId == sql",
          "group": "pgsql-tools"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/vscode": "^1.120.0",
    "typescript": "^6.0.3"
  }
}
