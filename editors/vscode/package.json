{
  "name": "pgsql-tools",
  "displayName": "pgsql-tools",
  "description": "PostgreSQL SQL + PL/pgSQL language support (type-checking, completion, hover)",
  "version": "0.1.0",
  "publisher": "pgsql-tools",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages", "Linters"],
  "activationEvents": ["onLanguage:sql"],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "sql",
        "aliases": ["SQL", "sql", "PostgreSQL", "pgsql"],
        "extensions": [".sql", ".pgsql"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sql",
        "scopeName": "source.sql",
        "path": "./syntaxes/pgsql.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "pgsql-tools",
      "properties": {
        "pgsql-tools.lspPath": {
          "type": "string",
          "default": "pgsql-lsp",
          "description": "Path to the pgsql-lsp binary"
        },
        "pgsql-tools.schemaFile": {
          "type": "string",
          "default": "",
          "description": "Path to a schema.sql file for type-checking"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
