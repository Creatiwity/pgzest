<idea-plugin>
  <id>com.pgzest.jetbrains</id>
  <name>pgzest</name>
  <version>0.1.0</version>
  <vendor email="pgzest@example.com" url="https://github.com/Creatiwity/pgzest">
    pgzest
  </vendor>
  <description><![CDATA[
    PostgreSQL SQL + PL/pgSQL language support for JetBrains IDEs.
    Provides type-checking, linting, hover, and completion via the pgzest-lsp server.
    <br/>
    Features:
    <ul>
      <li>Real-time type-checking (E001, E003...)</li>
      <li>Lint rules (L001-L009)</li>
      <li>Hover: shows column types</li>
      <li>Completion: columns from schema</li>
    </ul>
  ]]></description>
  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.lang</depends>
  <!-- LSP4IJ provides the LSP client infrastructure -->
  <depends>com.redhat.devtools.lsp4ij</depends>

  <extensions defaultExtensionNs="com.intellij">
    <!-- Language file type -->
    <fileType name="SQL" implementationClass="com.pgzest.PgsqlFileType"
              language="SQL" extensions="sql;pgsql"/>
  </extensions>

  <extensions defaultExtensionNs="com.redhat.devtools.lsp4ij">
    <server id="pgzest-lsp"
            name="pgzest-lsp"
            factoryClass="com.pgzest.PgsqlLspServerDefinition">
      <description>PostgreSQL language server (pgzest-lsp)</description>
    </server>
    <languageMapping language="SQL"
                     serverId="pgzest-lsp"
                     filePattern="*.sql"/>
    <languageMapping language="SQL"
                     serverId="pgzest-lsp"
                     filePattern="*.pgsql"/>
  </extensions>
</idea-plugin>
