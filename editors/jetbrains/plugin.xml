<idea-plugin>
  <id>com.pgzest.jetbrains</id>
  <name>pgzest</name>
  <version>0.1.0</version>
  <vendor email="hello@creatiwity.net" url="https://creatiwity.net">
    Creatiwity
  </vendor>
  <description><![CDATA[
    PostgreSQL SQL + PL/pgSQL language support for JetBrains IDEs.
    Diagnostics, hover and completion from the pgzest language server
    (<code>pgzest lsp</code>): SQL checked the way PostgreSQL would, without a
    database.
  ]]></description>
  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.lang</depends>
  <!-- LSP4IJ provides the LSP client infrastructure -->
  <depends>com.redhat.devtools.lsp4ij</depends>

  <extensions defaultExtensionNs="com.intellij">
    <!-- Language file type -->
    <fileType name="SQL" implementationClass="com.pgzest.PgsqlFileType"
              language="SQL" extensions="sql;pgsql"/>
  </extensions>

  <extensions defaultExtensionNs="com.redhat.devtools.lsp4ij">
    <server id="pgzest"
            name="pgzest"
            factoryClass="com.pgzest.PgsqlLspServerDefinition">
      <description>PostgreSQL language server (pgzest lsp)</description>
    </server>
    <languageMapping language="SQL"
                     serverId="pgzest"
                     filePattern="*.sql"/>
    <languageMapping language="SQL"
                     serverId="pgzest"
                     filePattern="*.pgsql"/>
  </extensions>
</idea-plugin>
